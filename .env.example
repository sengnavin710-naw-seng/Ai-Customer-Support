# Run npm run setup to generate local-only credentials. Never commit .env.
NODE_ENV=development
API_PORT=3000
WEB_ORIGIN=http://localhost:5173
POSTGRES_USER=support_dev
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_LOCAL_PASSWORD
POSTGRES_DB=support_dev
POSTGRES_PORT=5432
DATABASE_URL=postgresql://support_dev:REPLACE_WITH_RANDOM_LOCAL_PASSWORD@localhost:5432/support_dev
DEV_ADMIN_EMAIL=admin@example.test
# salt:64-byte-scrypt-hash (hex). Generated by npm run setup.
DEV_ADMIN_PASSWORD_HASH=GENERATE_WITH_NPM_RUN_SETUP
